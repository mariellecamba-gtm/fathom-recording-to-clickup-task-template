# Local runs only. In GitHub Actions these come from repository secrets.
# Never commit the filled-in copy: .env is in .gitignore.
FATHOM_API_KEY=
CLICKUP_API_TOKEN=
# PASS 3 (mention scan), and PASS 1's fallback for action items with no client name.
# Leave blank to run passes 1 and 2 on alias matching alone.
ANTHROPIC_API_KEY=
